{
  "name": "dsh-canvas",
  "version": "0.2.72",
  "private": true,
  "description": "Local image, video and FishTTS generation canvas plugin for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "docs",
    "scripts/patch-thinking-orbs.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-thinking-orbs.mjs",
    "build": "node scripts/build.mjs",
    "pretypecheck": "node scripts/patch-thinking-orbs.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "pretest": "node scripts/patch-thinking-orbs.mjs",
    "test": "vitest run --maxWorkers=2",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run docs:check && npm run typecheck && npm test && npm run build",
    "dev": "node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@xyflow/react": "^12.8.0",
    "ali-oss": "6.23.0",
    "border-beam": "1.4.1",
    "crypto-js": "4.2.0",
    "form-data": "4.0.6",
    "img-fx": "0.5.1",
    "proper-lockfile": "^4.1.2",
    "sharp": "0.35.5",
    "thinking-orbs": "0.3.2",
    "three": "0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@types/ali-oss": "6.23.3",
    "@types/crypto-js": "4.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
